# 필요한 항목만 실제 .env에 복사하세요. 기존 키를 빈 값으로 덮어쓰지 마세요.
BAZE_API_KEY=
NERVIS_BAZE_BASE_URL=https://factchat-cloud.mindlogic.ai/v1/gateway
NERVIS_LLM_MODEL=gpt-5.4-mini
# true: AI 활성화·호출 횟수 제한 없음·사용량 과금. 변경 후 백엔드 재시작.
NERVIS_AI_ENABLED=false

# 기상청 일반 인증키. 변경 후 백엔드 재시작.
NERVIS_KMA_API_KEY=
NERVIS_WEATHER_LOCATION=춘천
NERVIS_TIMEZONE=Asia/Seoul

# PostgreSQL도 이 .env 하나를 사용합니다. docker compose up -d --wait
# 기존 DB를 쓰는 경우 기존 비밀번호를 그대로 유지하세요.
NERVIS_DB_PASSWORD=
NERVIS_DB_PORT=15432

# TTS: 기본 예시는 ElevenLabs. hai_gpt 선택 시 기존 BAZE_API_KEY 사용. 음성 생성 과금.
NERVIS_TTS_MODEL=gemini-3.1-flash-tts-preview
# VoiceStudio saved voice profile name or ID (not the synthesis engine).
NERVIS_VOICESTUDIO_VOICE=JARVIS
NERVIS_VIDEO_MODEL=
NERVIS_TTS_BACKEND=elevenlabs
NERVIS_TTS_VOICE=Schedar

# ElevenLabs: set NERVIS_TTS_BACKEND=elevenlabs to select it. Keep keys server-side.
ELEVENLABS_API_KEY=
ELEVENLABS_MODEL_ID=eleven_v3
# My Voices -> your Korean voice -> ... -> Copy voice ID (not its display name).
ELEVENLABS_VOICE_ID=
