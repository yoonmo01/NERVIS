# 실제 키는 루트 .env에만 넣고 기존 키는 그대로 유지하세요.
# 이 파일을 기존 .env 위에 통째로 복사하면 키가 지워집니다.
# 올바른 변수명은 BAZE_API_KEY입니다. 프런트용 VITE_ 변수에 키를 넣지 마세요.
BAZE_API_KEY=

# 현재 지원하는 BAZE Gateway 주소. 변경하지 않아도 됩니다.
NERVIS_BAZE_BASE_URL=https://factchat-cloud.mindlogic.ai/v1/gateway

# 현재 선택한 채팅/도구 호출 모델.
NERVIS_LLM_MODEL=gpt-5.4-mini

# 기본값 0 = 실제 API 전송 꺼짐. 허용 범위는 정수 0~10입니다.
# 직접 테스트할 때 실제 .env에서 아래 값을 6으로 바꾸면 됩니다:
# NERVIS_AI_MAX_REQUESTS=6
# 6은 크레딧/질문 수가 아니라 서버 프로세스의 외부 요청 최대 횟수입니다.
# 도구 명령은 보통 2회(도구 선택 + 완료 응답)를 사용하므로 약 3건입니다.
# 실패/시간 초과도 횟수에 포함됩니다. 금액 한도는 아니며 자동 재시도는 없습니다.
NERVIS_AI_MAX_REQUESTS=0

# 아직 STT/TTS·영상 생성은 연결하지 않았습니다. 비워 두세요.
NERVIS_TTS_MODEL=
NERVIS_VIDEO_MODEL=

# .env 변경은 실행 중인 서버에 즉시 반영되지 않습니다.
# 서버를 종료하고 python -m backend로 다시 시작한 뒤 화면의
# 'AI 설정 상태 확인'을 누르거나 페이지를 새로 열어 확인하세요.
# 재시작하면 메모리의 사용 횟수가 초기화되지만 승인 예산이 늘어나는 것은 아닙니다.
# 2026-10-23 직접 테스트용 서버는 이미 모델/예산6으로 실행했으므로 해당 실행은 재시작할 필요가 없습니다.
#
# 같은 이름의 OS/터미널 환경변수가 있으면 .env보다 우선합니다.
# .env 기준으로 새 서버를 실행하려면 PowerShell에서 해당 임시 설정을 지우세요:
# Remove-Item Env:NERVIS_LLM_MODEL -ErrorAction SilentlyContinue
# Remove-Item Env:NERVIS_AI_MAX_REQUESTS -ErrorAction SilentlyContinue
# python -m backend
#
# 키 설정이나 예시 복사만으로 에이전트의 외부 API 시험이 승인되는 것은 아닙니다.
