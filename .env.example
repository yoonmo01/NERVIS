# 실제 키는 루트 .env에만 넣고 기존 키를 보존하세요. 이 예시를 통째로 덮어쓰지 마세요.
# 키를 VITE_ 변수에 넣지 마세요. 브라우저로 노출됩니다.
BAZE_API_KEY=
NERVIS_BAZE_BASE_URL=https://factchat-cloud.mindlogic.ai/v1/gateway
NERVIS_LLM_MODEL=gpt-5.4-mini

# false = 전송 꺼짐. 본인이 앱을 사용할 때 true로 바꾸고 백엔드를 다시 시작하세요.
# true는 앱의 총 호출 횟수를 제한하지 않습니다. 사용한 만큼 실제 요금이 발생합니다.
# 명령당 최대 2회: 도구 선택(출력 최대 512토큰), 결과 설명(출력 최대 1200토큰).
# 입력 토큰도 과금되며 자동 재시도·모델 전환·잔액 조회는 하지 않습니다.
NERVIS_AI_ENABLED=false

# 이전 NERVIS_AI_MAX_REQUESTS=0을 무제한으로 재해석하지 않습니다.
# AI_ENABLED가 있으면 MAX_REQUESTS는 앱 활성화에 사용하지 않습니다.
# AI_ENABLED가 없을 때만 이전 0~10회 제한 동작을 유지합니다.
# scripts/check_baze.py의 명시적 시험 상한은 AI_ENABLED=true여도 그대로 적용됩니다.
# 에이전트 실계정 시험은 이 설정과 별개로 모델·횟수·비용·중단 조건의 사전 승인이 필요합니다.

# 아직 음성·영상 생성은 연결하지 않았습니다.
NERVIS_TTS_MODEL=
NERVIS_VIDEO_MODEL=

# 변경 후 python -m backend로 서버를 다시 시작하고 페이지를 새로 열어 주세요.
# OS/터미널 환경변수는 .env보다 우선합니다. 임시 설정을 사용했다면 PowerShell에서:
# Remove-Item Env:NERVIS_AI_ENABLED -ErrorAction SilentlyContinue
# Remove-Item Env:NERVIS_AI_MAX_REQUESTS -ErrorAction SilentlyContinue
# Remove-Item Env:NERVIS_LLM_MODEL -ErrorAction SilentlyContinue
# python -m backend
# 이 파일은 실제 .env를 수정하거나 현재 서버의 소진된 승인을 연장하지 않습니다.
