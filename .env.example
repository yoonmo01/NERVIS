# Required for future BAZE requests. Keep the real value only in .env.
# Copy this file to .env only when .env does not already exist.
BAZE_API_KEY=

# Optional: the application will use this documented gateway by default.
NERVIS_BAZE_BASE_URL=https://factchat-cloud.mindlogic.ai/v1/gateway

# Optional: leave blank until an approved model-list check selects real IDs.
NERVIS_LLM_MODEL=
NERVIS_TTS_MODEL=
NERVIS_VIDEO_MODEL=

# A configured key is not permission to make API requests or spend credits.
